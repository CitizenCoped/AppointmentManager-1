# Serasomatic CRM — environment variables. Blank values only; never commit real secrets.
# Vercel is the system of record: set values in the Vercel project, then run
#   vercel env pull .env
# Full inventory, status and recovery runbook: docs/cred-update/spec.md

# ---------- Core (required to boot) ----------
DATABASE_URL=                 # Neon Postgres. Vercel: pooled (-pooler) string; local: direct string
SESSION_SECRET=               # Signs session cookies AND encrypts stored TOTP secrets. Do not rotate casually.
NODE_ENV=development
PORT=5050

# ---------- Auth / signed links ----------
TOTP_ENCRYPTION_KEY=          # Optional. Defaults to SESSION_SECRET. Never introduce or change after MFA enrolment
                              # without re-encrypting users.totp_secret (all authenticators break otherwise).
INVITE_SECRET=                # Optional. HMAC for admin invite links; defaults to SESSION_SECRET.
DEPOSIT_CONFIRM_SECRET=       # Optional. HMAC for public deposit-return links; defaults to SESSION_SECRET.
ALLOW_REGISTRATION=false      # Only "true" opens POST /api/auth/register. Keep false in production.
APP_BASE_URL=                 # https://serasomatic.vercel.app — base for emailed links (defaults to Vercel URL)

# ---------- Google Calendar (OAuth 2.0, one shared refresh token) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=         # Minted via OAuth Playground with calendar + calendar.events scopes (spec §10 DC1)
GOOGLE_CALENDAR_ID=           # Active appointments calendar
GOOGLE_ARCHIVE_CALENDAR_ID=   # Completed/cancelled calendar (optional; falls back to active)

# ---------- Email (Gmail SMTP via nodemailer) ----------
GMAIL_EMAIL=                  # Sender mailbox
GMAIL_APP_PASSWORD=           # Gmail App Password (requires 2-Step Verification)
NOTIFICATION_EMAIL=           # Default recipient for internal appointment notifications

# ---------- AI extraction (Conversation Create) ----------
ANTHROPIC_API_KEY=

# ---------- Chat bridge (CRM side; only once the Horizon gateway ships) ----------
CHAT_WEB_TOKEN_SECRET=        # Must equal the gateway's WEB_TOKEN_SECRET
VITE_GATEWAY_URL=             # Public gateway URL returned to the widget (read server-side)

# ---------- One-off scripts (pass inline, do not persist) ----------
# SEED_ADMIN_EMAIL= SEED_ADMIN_PASSWORD= SEED_ADMIN_USERNAME=   → npm run db:seed-admin
# INVITE_EMAIL= INVITE_USERNAME=                                → npm run db:invite-admin

# Not read by this app (remove if present): PGHOST PGPORT PGUSER PGPASSWORD PGDATABASE DD_API_KEY DD_SERVICE DD_ENV

# ================= Horizon chat gateway (gateway/, Phase 2, deployed separately on Fly.io) =================
NEON_DATABASE_URL=            # Gateway may use this instead of DATABASE_URL; dev branch only until Wave 5
REDIS_URL=
XAI_API_KEY=
GROK_MODEL=
TYPESAFE_API_KEY=
JEV_MODEL=
JEV_TIMEOUT_MS=1500
JEV_TAKEOVER_THRESHOLD=0.85
JEV_MIN_CONFIDENCE=0.6
JEV_FAIL_MODE=open
WEB_TOKEN_SECRET=             # Same value as CHAT_WEB_TOKEN_SECRET above
CRM_SESSION_SECRET=           # Same value as the CRM's SESSION_SECRET
CRM_BASE_URL=
GATEWAY_PUBLIC_URL=
REPLICA_ID=
LOG_LEVEL=info
# Optional until SMS wave
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_URL=
